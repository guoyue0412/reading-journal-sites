{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guoyue-reading-journal",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./public" },
  "vars": { "MIGRATION_MODE": "false", "PUBLIC_ORIGIN": "http://localhost:3000", "CF_ACCESS_TEAM_DOMAIN": "local.invalid", "CF_ACCESS_AUD": "LOCAL_CONFIGURATION_REQUIRED" },
  "d1_databases": [{ "binding": "DB", "database_name": "reading-journal-d1-local", "database_id": "11111111-1111-4111-8111-111111111111", "migrations_dir": "drizzle" }],
  "r2_buckets": [{ "binding": "BLOG_ASSETS", "bucket_name": "reading-journal-assets-local" }],
  "env": {
    "staging": {
      "name": "guoyue-reading-journal-staging",
      "vars": { "MIGRATION_MODE": "true", "PUBLIC_ORIGIN": "https://staging.invalid", "CF_ACCESS_TEAM_DOMAIN": "staging.invalid", "CF_ACCESS_AUD": "STAGING_CONFIGURATION_REQUIRED" },
      "d1_databases": [{ "binding": "DB", "database_name": "reading-journal-d1-staging", "database_id": "22222222-2222-4222-8222-222222222222", "migrations_dir": "drizzle" }],
      "r2_buckets": [{ "binding": "BLOG_ASSETS", "bucket_name": "reading-journal-assets-staging" }]
    },
    "production": {
      "name": "guoyue-reading-journal",
      "vars": { "MIGRATION_MODE": "true", "PUBLIC_ORIGIN": "https://production.invalid", "CF_ACCESS_TEAM_DOMAIN": "production.invalid", "CF_ACCESS_AUD": "PRODUCTION_CONFIGURATION_REQUIRED" },
      "d1_databases": [{ "binding": "DB", "database_name": "reading-journal-d1-production", "database_id": "33333333-3333-4333-8333-333333333333", "migrations_dir": "drizzle" }],
      "r2_buckets": [{ "binding": "BLOG_ASSETS", "bucket_name": "reading-journal-assets-production" }]
    }
  }
}
